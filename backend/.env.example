# Copia este archivo como .env y ajusta los valores si hace falta.
# El archivo .env no se versiona y no debe contener secretos escritos en claro.

# Puerto en el que escucha el backend. El proxy del frontend espera 3000.
PORT=3000

# Directorio donde se guardan los archivos subidos.
# Puede ser relativo a la carpeta backend/ o una ruta absoluta.
DIRECTORIO_SUBIDAS=subidas

# Conexión con PostgreSQL. Son las variables estándar de PostgreSQL, que tanto
# psql como el driver pg interpretan por sí solos.
# Para crear el rol y las bases de datos, consulta database/README.md.
PGHOST=localhost
PGPORT=5432
PGDATABASE=pwa_tareas_03
PGUSER=pwa_tareas_03_app
PGPASSWORD=
